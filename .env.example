# Local OTA settings for the kc868a2_ota environment.
# Copy this file to .env, fill in the real values, and never commit .env.
# NAVIER_OTA_AUTH is injected into the firmware at build time for the
# kc868a2_ota env, so it always matches the ArduinoOTA password.
# NAVIER_OTA_AUTH must not contain double-quote or backslash characters.
NAVIER_OTA_IP=192.168.1.xx
NAVIER_OTA_AUTH=change-me
